generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  PARTNER
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MERCADO_PAGO
  CREDIT_CARD
  DEBIT_CARD
  PIX
}

enum PaymentStatus {
  PENDING
  APPROVED
  REFUSED
  CANCELLED
  REFUNDED
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  password        String?
  name            String?
  phone           String?
  avatarUrl       String?
  role            UserRole      @default(CUSTOMER)
  googleId        String?       @unique
  appleId         String?       @unique
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  storeName        String?
  storeDescription String?
  storeLogo        String?
  cnpj             String?       @unique
  partnerStatus    PartnerStatus?
  commissionRate   Float?        @default(10)

  mpUserId         String?
  mpAccessToken    String?
  mpRefreshToken   String?

  addresses        Address[]
  orders           Order[]
  cart             Cart?
  refreshToken     String?
  products         Product[]
  partnerEarnings  PartnerEarning[]

  @@map("users")
}

model Address {
  id          String  @id @default(uuid())
  userId      String
  label       String?
  street      String
  number      String
  complement  String?
  neighborhood String
  city        String
  state       String
  zipCode     String
  lat         Float?
  lng         Float?
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@map("addresses")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  price         Decimal       @db.Decimal(10, 2)
  discountedPrice Decimal?    @db.Decimal(10, 2)
  imageUrl      String?
  images        String[]
  categoryId    String
  partnerId     String?
  isActive      Boolean       @default(true)
  isFeatured    Boolean       @default(false)
  preparationTime Int?        @default(15)
  ingredients   String?
  stockQuantity Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category      Category      @relation(fields: [categoryId], references: [id])
  partner       User?         @relation(fields: [partnerId], references: [id])
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@map("products")
}

model Cart {
  id        String    @id @default(uuid())
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  couponId  String?
  coupon    Coupon?   @relation(fields: [couponId], references: [id])

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  addressId       String?
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  platformFee     Decimal?      @db.Decimal(10, 2)
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?
  notes           String?
  couponId        String?
  estimatedTime   Int?
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  address         Address?      @relation(fields: [addressId], references: [id])
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  partnerEarnings PartnerEarning[]

  @@map("orders")
}

model PartnerEarning {
  id              String   @id @default(uuid())
  orderId         String
  partnerId       String
  amount          Decimal  @db.Decimal(10, 2)
  platformFee     Decimal  @db.Decimal(10, 2)
  status          String   @default("PENDING")
  transferId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order           Order    @relation(fields: [orderId], references: [id])
  partner         User     @relation(fields: [partnerId], references: [id])

  @@map("partner_earnings")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  description String?
  discountType String    @default("PERCENTAGE")
  discountValue Decimal  @db.Decimal(10, 2)
  minOrderValue Decimal? @db.Decimal(10, 2)
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders      Order[]
  carts       Cart[]

  @@map("coupons")
}
